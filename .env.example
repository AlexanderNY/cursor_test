# Скопируйте в .env и подставьте реальные значения:
#   cp .env.example .env
# Файл .env не коммитить (см. .gitignore).
#
# Ротация: если пароль/JWT уже были в git — смените PostgreSQL password
# и сгенерируйте новый JWT: openssl rand -hex 32
# SECRET_KEY и JWT_SECRET_KEY должны совпадать.
#
# Важно: в значениях для Docker Compose символ $ интерполируется как ${VAR}.
# Не используйте bcrypt-хеши ($2b$12$...) как JWT — Compose «съест» $... как имена переменных.
# Если в пароле нужен литеральный $, пишите $$ (удвоенный).

DATABASE_URL=dbname=db_bot user=postgres password=1qaz!QAZ host=host.docker.internal
# 9to18.ru — отдельный файл .env.9to18 (SITE_DATABASE_URL). Пример: .env.9to18.example
# aiopg pool (core, auth, collector, processor, bots…)
# Сумма max по сервисам должна быть < Postgres max_connections (при росте — PgBouncer).
DB_POOL_MINSIZE=2
DB_POOL_MAXSIZE=8
JWT_SECRET_KEY=REPLACE_WITH_OPENSSL_RAND_HEX_32
SECRET_KEY=REPLACE_WITH_OPENSSL_RAND_HEX_32

S3_ACCESS_KEY=admin
S3_SECRET_KEY=admin123
# Для браузера (Administration → Storage, превью картинок). Внутри Docker API остаётся http://minio:9000.
S3_PUBLIC_ENDPOINT_URL=http://localhost:9000
MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=admin123
# MINIO_SERVER_URL=http://localhost:9000
# MINIO_BROWSER_REDIRECT_URL=http://localhost:9001

# tg-game: токен от BotFather (отозвать старый, если светился в git) + openssl rand -hex 32
GAME_BOT_TOKEN=REPLACE_ME_BOTFATHER_TOKEN
GAME_ADMIN_API_TOKEN=REPLACE_WITH_OPENSSL_RAND_HEX_32
# GAME_ADMIN_TELEGRAM_IDS=123456789

# Gateway: CIDR, которым доверяем X-Forwarded-For (edge + docker network)
# TRUSTED_PROXY_CIDRS=127.0.0.0/8,::1/128,172.20.0.0/16

# Selenium / Chromium concurrency across bots
# SELENIUM_MAX_CONCURRENT=2

# Параллельные AI-вызовы к Ollama
# AI_MAX_CONCURRENT=1

# VK: App ID/Secret/Callback confirmation+secret — только в UI (vk_profiles), не в env.
# VK_PUBLIC_GATEWAY_URL=http://localhost:8000
# FRONTEND_URL=http://localhost:8100
# Callback API URL = {VK_PUBLIC_GATEWAY_URL}/vk/callback

# Stripe billing (auth service). BASIC/PREMIUM — legacy aliases for STANDARD/FULL.
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_PRICE_STANDARD=
# STRIPE_PRICE_FULL=
# STRIPE_PRICE_BASIC=
# STRIPE_PRICE_PREMIUM=
# Reserved for future metered billing (not wired):
# STRIPE_METERED_AI_PRICE_ID=
# STRIPE_METERED_POSTS_PRICE_ID=
# BILLING_PORTAL_RETURN_URL=http://localhost:5173/profile?tab=billing
# BILLING_CHECKOUT_SUCCESS_URL=http://localhost:5173/profile?tab=billing&checkout=success
# BILLING_CHECKOUT_CANCEL_URL=http://localhost:5173/profile?tab=billing&checkout=cancel

# Доп. origins для редиректа после VK OAuth (через запятую)
# VK_OAUTH_ALLOWED_FRONTENDS=http://localhost:8100,https://www.copyparse.ru

# Telegram MTProto proxy for tg-bot (нужен при блокировке Telegram).
# Локальный Clash/sing-box: socks5://host.docker.internal:10808
# TELEGRAM_PROXY_URL=socks5://host.docker.internal:10808

# Часовой пояс для расписаний (Custom URL schedule_time и др.)
# TZ=Europe/Moscow

# Жёсткий выключатель AI (Ollama). Runtime-тоггл — Checks → AI в UI.
# Модель по умолчанию: qwen2.5:1.5b (~1GB, ≤3GB). Переопределение: AI_MODEL=...
# Ollama API: http://ollama:11434 (Docker), http://127.0.0.1:11434 (хост), GPU: gpus: all
# AI_ENABLED=true
# AI_MODEL=qwen2.5:1.5b
