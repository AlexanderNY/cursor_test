# 9to18.ru independent stack — copy to .env and fill secrets
# PostgreSQL must already have database db_9to18 (or site-api will try CREATE DATABASE)

DATABASE_URL=dbname=db_9to18 user=postgres password=CHANGE_ME host=host.docker.internal
JWT_SECRET_KEY=CHANGE_ME_TO_LONG_HEX_OR_RANDOM_STRING

# Optional: MinIO/S3 for resume PDF/DOCX exports (resume-api). Empty = local disk uploads/resume/exports
# S3_ENDPOINT_URL=http://minio:9000
# S3_PUBLIC_ENDPOINT_URL=http://127.0.0.1:9000
# S3_BUCKET=uploads
# S3_ACCESS_KEY=minioadmin
# S3_SECRET_KEY=minioadmin
# S3_REGION=us-east-1
# S3_USE_SSL=false

# Optional: Ollama for resume AI (About / skill-gap / cover letter). Host port 11434.
# AI_ENABLED=true
# AI_SERVICE_URL=http://host.docker.internal:11434
# AI_MODEL=qwen2.5:1.5b
# AI_TIMEOUT_SEC=60
# AI_SETTINGS_URL=
