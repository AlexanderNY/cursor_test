# Copy to secret.yaml and fill in real values. Do not commit secret.yaml.
# kubectl apply -f k8s/base/secret.yaml
apiVersion: v1
kind: Secret
metadata:
  name: app-secrets
  namespace: app
type: Opaque
stringData:
  # PostgreSQL: for Minikube use host.minikube.internal as host (env var name = key)
  DATABASE_URL: "dbname=db_bot user=postgres password=REPLACE_ME host=host.minikube.internal port=5432"
  JWT_SECRET_KEY: "REPLACE_WITH_JWT_SECRET"
  # Optional: scheduler basic auth (if used)
  # SCHEDULER_LOGIN: ""
  # SCHEDULER_PASSWORD: ""
