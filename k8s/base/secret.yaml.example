# Copy to secret.yaml and fill in real values. Do not commit secret.yaml.
# kubectl apply -f k8s/base/secret.yaml
apiVersion: v1
kind: Secret
metadata:
  name: app-secrets
  namespace: app
type: Opaque
stringData:
  # PostgreSQL: for Minikube use host.minikube.internal as host (env var name = key)
  DATABASE_URL: "dbname=db_bot user=postgres password=REPLACE_ME host=host.minikube.internal port=5432"
  JWT_SECRET_KEY: "REPLACE_WITH_JWT_SECRET"
  # auth service reads SECRET_KEY (must match JWT_SECRET_KEY)
  SECRET_KEY: "REPLACE_WITH_JWT_SECRET"
  S3_ACCESS_KEY: "REPLACE_ME"
  S3_SECRET_KEY: "REPLACE_ME"
  GAME_BOT_TOKEN: "REPLACE_ME_BOTFATHER_TOKEN"
  GAME_ADMIN_API_TOKEN: "REPLACE_WITH_OPENSSL_RAND_HEX_32"
  GAME_ADMIN_TELEGRAM_IDS: ""
  TRUSTED_PROXY_CIDRS: "127.0.0.0/8,::1/128,10.0.0.0/8"
