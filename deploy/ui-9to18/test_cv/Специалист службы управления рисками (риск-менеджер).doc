\trowd\cellx1800\cellx9638\pard\intbl\itap1\sl220{\fs16\cf3 \uc0\u1054 \uc0\u1073 \uc0\u1086  \uc0\u1084 \uc0\u1085 \uc0\u1077 }\cell
\pard\intbl\itap1\sl260{\fs18 \uc0\u1055 \uc0\u1088 \uc0\u1086 \uc0\u1092 \uc0\u1077 \uc0\u1089 \uc0\u1089 \uc0\u1080 \uc0\u1086 \uc0\u1085 \uc0\u1072 \uc0\u1083 \uc0\u1100 \uc0\u1085 \uc0\u1099 \uc0\u1077  \uc0\u1085 \uc0\u1072 \uc0\u1074 \uc0\u1099 \uc0\u1082 \uc0\u1080 :{\line}\uc0\u1047 \uc0\u1085 \uc0\u1072 \uc0\u1085 \uc0\u1080 \uc0\u1077  \uc0\u1085 \uc0\u1086 \uc0\u1088 \uc0\u1084 \uc0\u1072 \uc0\u1090 \uc0\u1080 \uc0\u1074 \uc0\u1085 \uc0\u1099 \uc0\u1093  \uc0\u1076 \uc0\u1086 \uc0\u1082 \uc0\u1091 \uc0\u1084 \uc0\u1077 \uc0\u1085 \uc0\u1090 \uc0\u1086 \uc0\u1074  \uc0\u1062 \uc0\u1041  \uc0\u1056 \uc0\u1060  {\line}199-\uc0\u1048  {\line}385-\uc0\u1055  {\line}254-\uc0\u1055  {\line}283-\uc0\u1055  {\line}387-\uc0\u1055  (511){\line}192-T{\line}3624-\uc0\u1059 {\line}{\line}\uc0\u1047 \uc0\u1085 \uc0\u1072 \uc0\u1085 \uc0\u1080 \uc0\u1077  \uc0\u1090 \uc0\u1088 \uc0\u1077 \uc0\u1073 \uc0\u1086 \uc0\u1074 \uc0\u1072 \uc0\u1085 \uc0\u1080 \uc0\u1081  \uc0\u1041 \uc0\u1072 \uc0\u1079 \uc0\u1077 \uc0\u1083 \uc0\u1100 -2, 3 (\uc0\u1042  \uc0\u1090 \uc0\u1086 \uc0\u1084  \uc0\u1095 \uc0\u1080 \uc0\u1089 \uc0\u1083 \uc0\u1077  \uc0\u1088 \uc0\u1072 \uc0\u1089 \uc0\u1095 \uc0\u1077 \uc0\u1090 \uc0\u1072  PD, LGD, EAD, VAR \uc0\u1080  \uc0\u1090 .\uc0\u1076 .){\line}{\line}\uc0\u1051 \uc0\u1080 \uc0\u1095 \uc0\u1085 \uc0\u1099 \uc0\u1077  \uc0\u1080 \uc0\u1085 \uc0\u1090 \uc0\u1077 \uc0\u1088 \uc0\u1077 \uc0\u1089 \uc0\u1099 :{\line}\uc0\u1057 \uc0\u1087 \uc0\u1086 \uc0\u1088 \uc0\u1090  (\uc0\u1083 \uc0\u1099 \uc0\u1078 \uc0\u1080 , \uc0\u1087 \uc0\u1083 \uc0\u1072 \uc0\u1074 \uc0\u1072 \uc0\u1085 \uc0\u1080 \uc0\u1077 , \uc0\u1074 \uc0\u1077 \uc0\u1083 \uc0\u1086 \uc0\u1089 \uc0\u1080 \uc0\u1087 \uc0\u1077 \uc0\u1076 );{\line}\uc0\u1063 \uc0\u1090 \uc0\u1077 \uc0\u1085 \uc0\u1080 \uc0\u1077  \uc0\u1082 \uc0\u1085 \uc0\u1080 \uc0\u1075 ;{\line}\uc0\u1055 \uc0\u1088 \uc0\u1086 \uc0\u1075 \uc0\u1088 \uc0\u1072 \uc0\u1084 \uc0\u1084 \uc0\u1080 \uc0\u1088 \uc0\u1086 \uc0\u1074 \uc0\u1072 \uc0\u1085 \uc0\u1080 \uc0\u1077 (web-\uc0\u1088 \uc0\u1072 \uc0\u1079 \uc0\u1088 \uc0\u1072 \uc0\u1073 \uc0\u1086 \uc0\u1090 \uc0\u1082 \uc0\u1072 , \uc0\u1084 \uc0\u1072 \uc0\u1082 \uc0\u1088 \uc0\u1086 \uc0\u1089 \uc0\u1099 );{\line}\uc0\u1050 \uc0\u1080 \uc0\u1085 \uc0\u1086 .{\line}{\line}\uc0\u1051 \uc0\u1080 \uc0\u1095 \uc0\u1085 \uc0\u1099 \uc0\u1077  \uc0\u1082 \uc0\u1072 \uc0\u1095 \uc0\u1077 \uc0\u1089 \uc0\u1090 \uc0\u1074 \uc0\u1072 :{\line}\uc0\u1052 \uc0\u1086 \uc0\u1083 \uc0\u1086 \uc0\u1076 \uc0\u1086 \uc0\u1081  \uc0\u1080  \uc0\u1101 \uc0\u1085 \uc0\u1077 \uc0\u1088 \uc0\u1075 \uc0\u1080 \uc0\u1095 \uc0\u1085 \uc0\u1099 \uc0\u1081 , \uc0\u1075 \uc0\u1086 \uc0\u1090 \uc0\u1086 \uc0\u1074  \uc0\u1082  \uc0\u1083 \uc0\u1102 \uc0\u1073 \uc0\u1099 \uc0\u1084  \uc0\u1087 \uc0\u1077 \uc0\u1088 \uc0\u1077 \uc0\u1084 \uc0\u1077 \uc0\u1085 \uc0\u1072 \uc0\u1084 , \uc0\u1093 \uc0\u1086 \uc0\u1088 \uc0\u1086 \uc0\u1096 \uc0\u1086  \uc0\u1074 \uc0\u1083 \uc0\u1080 \uc0\u1074 \uc0\u1072 \uc0\u1102 \uc0\u1089 \uc0\u1100  \uc0\u1074  \uc0\u1082 \uc0\u1086 \uc0\u1083 \uc0\u1083 \uc0\u1077 \uc0\u1082 \uc0\u1090 \uc0\u1080 \uc0\u1074 , \uc0\u1085 \uc0\u1077 \uc0\u1082 \uc0\u1086 \uc0\u1085 \uc0\u1092 \uc0\u1083 \uc0\u1080 \uc0\u1082 \uc0\u1090 \uc0\u1085 \uc0\u1099 \uc0\u1081 , \uc0\u1089 \uc0\u1090 \uc0\u1088 \uc0\u1077 \uc0\u1084 \uc0\u1083 \uc0\u1102 \uc0\u1089 \uc0\u1100  \uc0\u1082  \uc0\u1089 \uc0\u1072 \uc0\u1084 \uc0\u1086 \uc0\u1089 \uc0\u1086 \uc0\u1074 \uc0\u1077 \uc0\u1088 \uc0\u1096 \uc0\u1077 \uc0\u1085 \uc0\u1089 \uc0\u1090 \uc0\u1074 \uc0\u1086 \uc0\u1074 \uc0\u1072 \uc0\u1085 \uc0\u1080 \uc0\u1102 , \uc0\u1087 \uc0\u1086 \uc0\u1074 \uc0\u1099 \uc0\u1096 \uc0\u1077 \uc0\u1085 \uc0\u1080 \uc0\u1102  \uc0\u1082 \uc0\u1074 \uc0\u1072 \uc0\u1083 \uc0\u1080 \uc0\u1092 \uc0\u1080 \uc0\u1082 \uc0\u1072 \uc0\u1094 \uc0\u1080 \uc0\u1080  \uc0\u1080  \uc0\u1086 \uc0\u1073 \uc0\u1088 \uc0\u1072 \uc0\u1079 \uc0\u1086 \uc0\u1074 \uc0\u1072 \uc0\u1085 \uc0\u1080 \uc0\u1103 .}\cell\row



