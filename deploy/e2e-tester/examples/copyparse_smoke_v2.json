{
  "schema_version": 2,
  "name": "copyparse_smoke",
  "site": "copyparse",
  "base_url": "https://www.copyparse.ru",
  "defaults": {
    "timeout_ms": 30000,
    "login": {
      "path": "/sign-in",
      "username_selector": "input[placeholder=\"Enter your username\"]",
      "password_selector": "input[type=\"password\"]",
      "submit_selector": "button[type=\"submit\"]"
    }
  },
  "sections": [
    {
      "id": "auth",
      "title": "Login",
      "actions": [
        { "action": "login_form" },
        { "action": "wait_url", "contains": "/profile", "timeout_ms": 30000 },
        { "action": "assert_text", "selector": "body", "contains": "Profile" },
        { "action": "screenshot", "name": "S00_login" }
      ]
    },
    {
      "id": "nav",
      "title": "Shell navigation",
      "subsections": [
        {
          "id": "brands_nav",
          "title": "Brands",
          "on_enter": [{ "action": "goto", "path": "/brands" }],
          "actions": [
            { "action": "wait_url", "contains": "/brands" },
            { "action": "assert_text", "selector": "body", "contains": "Brands" }
          ]
        },
        {
          "id": "about_nav",
          "title": "About",
          "on_enter": [{ "action": "goto", "path": "/about" }],
          "actions": [
            { "action": "wait_url", "contains": "/about" },
            { "action": "assert_url", "contains": "/about" }
          ]
        },
        {
          "id": "profile_nav",
          "title": "Profile",
          "on_enter": [{ "action": "goto", "path": "/profile" }],
          "actions": [
            { "action": "wait_url", "contains": "/profile" },
            { "action": "assert_text", "selector": "body", "contains": "Profile" },
            { "action": "screenshot", "name": "S01_nav_shell" }
          ]
        }
      ]
    },
    {
      "id": "checks",
      "title": "Checks health (admin)",
      "on_enter": [{ "action": "goto", "path": "/checks/services-status" }],
      "actions": [
        { "action": "wait_url", "contains": "/checks/services-status" },
        { "action": "assert_text", "selector": "body", "contains": "Checks" },
        { "action": "assert_text", "selector": "body", "contains": "Services Status" },
        { "action": "click", "selector": "button:has-text(\"Load Services Status\")" },
        { "action": "wait", "ms": 5000 },
        { "action": "assert_text", "selector": "body", "contains": "Healthchecks" },
        { "action": "screenshot", "name": "S02_checks_health" }
      ]
    },
    {
      "id": "catalog",
      "title": "Brands / Channels / Posts",
      "subsections": [
        {
          "id": "brands",
          "title": "Brands list",
          "on_enter": [{ "action": "goto", "path": "/brands" }],
          "actions": [
            { "action": "wait_url", "contains": "/brands" },
            { "action": "assert_text", "selector": "body", "contains": "Brands" },
            { "action": "screenshot", "name": "S10_brands" }
          ]
        },
        {
          "id": "channels",
          "title": "Channels list",
          "on_enter": [{ "action": "goto", "path": "/channels" }],
          "actions": [
            { "action": "wait_url", "contains": "/channels" },
            { "action": "assert_text", "selector": "body", "contains": "Channels" },
            { "action": "screenshot", "name": "S11_channels" }
          ]
        },
        {
          "id": "posts",
          "title": "Posts list",
          "on_enter": [{ "action": "goto", "path": "/posts" }],
          "actions": [
            { "action": "wait_url", "contains": "/posts" },
            { "action": "assert_text", "selector": "body", "contains": "Posts" },
            { "action": "screenshot", "name": "S12_posts" }
          ]
        }
      ]
    },
    {
      "id": "platforms",
      "title": "Platform pages",
      "subsections": [
        {
          "id": "telegram",
          "title": "Telegram",
          "on_enter": [{ "action": "goto", "path": "/telegram" }],
          "actions": [
            { "action": "wait_url", "contains": "/telegram" },
            { "action": "assert_text", "selector": "body", "contains": "Telegram Integration" },
            { "action": "screenshot", "name": "S20_telegram" }
          ]
        },
        {
          "id": "custom_url",
          "title": "Custom URL",
          "on_enter": [{ "action": "goto", "path": "/custom-url" }],
          "actions": [
            { "action": "wait_url", "contains": "/custom-url" },
            { "action": "assert_text", "selector": "body", "contains": "Custom URL Integration" },
            { "action": "screenshot", "name": "S27_custom_url" }
          ]
        }
      ]
    }
  ]
}
