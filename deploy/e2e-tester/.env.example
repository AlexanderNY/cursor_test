# Скопируйте: cp deploy/e2e-tester/.env.example deploy/e2e-tester/.env
# Не коммитить .env

# Fernet key: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TESTER_SECRET_KEY=REPLACE_WITH_FERNET_KEY

# Цель — сервисы основного docker-compose на edge_net
TARGET_UI_URL=http://ui:8100
TARGET_API_URL=http://gateway:8000

# Postgres внутри tester compose (переопределяется в docker-compose.yml)
DATABASE_URL=dbname=tester user=tester password=tester host=tester-db

POSTGRES_USER=tester
POSTGRES_PASSWORD=tester
POSTGRES_DB=tester
