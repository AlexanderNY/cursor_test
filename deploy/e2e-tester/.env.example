# Скопируйте: cp deploy/e2e-tester/.env.example deploy/e2e-tester/.env
# Не коммитить .env

# Fernet key: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TESTER_SECRET_KEY=REPLACE_WITH_FERNET_KEY

# Цель тестов (публичный сайт или хост ПК)
TARGET_UI_URL=https://www.copyparse.ru
# Сайт на этом же ПК (пример):
# TARGET_UI_URL=http://host.docker.internal:8100

# SQLite внутри volume контейнера (отдельный Postgres не нужен)
SQLITE_PATH=/data/tester.db
